# Datos generados por el EA / herramientas (se conservan las carpetas)
XAUUSD_AUTONOMOUS/Files/*/*
!XAUUSD_AUTONOMOUS/Files/*/.gitkeep
# Binarios MQL5 compilados
*.ex5
*.ex4
# Configuraciones con posibles secretos
*.set
*.ini
.env
# Python
__pycache__/
*.pyc
.venv/
# Logs de compilación de MetaEditor
*.compile.log
# Dashboard web: base de datos y archivo de entorno con secretos
*.sqlite3
*.env
